generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String
  department     String
  semester       Int
  currentCgpa    Float
  createdAt      DateTime       @default(now())

  academicGoals  AcademicGoal[]
  courses        Course[]
  budgets        Budget[]
  expenses       Expense[]
  academicTasks  AcademicTask[]

  // --- Module 2 / Feature 3: Smart Job Aggregator ---
  jobPreference  JobPreference?
  savedJobs      SavedJob[]
  jobAlerts      JobAlert[]
}

model AcademicGoal {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterNumber   Int
  currentCgpa      Float
  completedCredits Int
  targetCgpa       Float
  upcomingCredits  Int
  requiredGpa      Float
  isPossible       Boolean
  createdAt        DateTime          @default(now())

  simulatedCourses SimulatedCourse[]
}

model SimulatedCourse {
  id             String       @id @default(cuid())
  academicGoalId String
  name           String
  credits        Float
  targetGrade    String

  academicGoal   AcademicGoal @relation(fields: [academicGoalId], references: [id], onDelete: Cascade)
}

model Course {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String
  title           String
  section         String
  credits         Float              @default(3.0)
  semesterNumber  Int                @default(1)
  classDays       String             @default("SUN, TUE") // e.g. "SUN, TUE"
  startTime       String             @default("09:30 AM")
  endTime         String             @default("10:45 AM")
  grade           String?
  totalClasses    Int                @default(0)
  attendedClasses Int                @default(0)
  missedClasses   Int                @default(0)
  createdAt       DateTime           @default(now())

  attendanceLogs  AttendanceRecord[]
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  status    String   // "PRESENT" or "ABSENT"
  createdAt DateTime @default(now())
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  month     Int      // 1-12
  year      Int      // e.g. 2026
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  category    String   // "FOOD", "TRANSIT", "PRINTING", "ACADEMIC", "ENTERTAINMENT", "OTHER"
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AcademicTask {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  course        String?
  type          String   // "ASSIGNMENT" or "QUIZ"
  dueAt         DateTime
  reminderHours Int      @default(24)
  notes         String?
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, dueAt])
}

// ---------------------------------------------------------------------------
// MODULE 2 - FEATURE 3
// Smart Job Aggregator & Alert System (LinkedIn + BDJobs)
// ---------------------------------------------------------------------------

/// A single employment / internship listing pulled from an external source.
/// Listings are shared across all users (one row per real-world job), while
/// per-student state lives in SavedJob / JobAlert.
model JobListing {
  id              String     @id @default(cuid())
  source          String     // "LINKEDIN" | "BDJOBS" | "CURATED"
  externalId      String     // the id given by the source
  url             String
  title           String
  company         String
  companyLogo     String?
  location        String     @default("Dhaka, Bangladesh")
  isRemote        Boolean    @default(false)
  jobType         String     @default("INTERNSHIP") // INTERNSHIP | FULL_TIME | PART_TIME | CONTRACT
  experienceLevel String     @default("ENTRY")      // INTERN | ENTRY | MID | SENIOR
  description     String     @db.Text
  skills          String[]   @default([])
  category        String     @default("GENERAL")    // SOFTWARE | DATA | HARDWARE | BUSINESS | FINANCE | MARKETING | GENERAL
  salaryText      String?
  minCgpa         Float?
  postedAt        DateTime   @default(now())
  deadline        DateTime?
  isActive        Boolean    @default(true)
  fetchedAt       DateTime   @default(now())
  createdAt       DateTime   @default(now())

  savedBy         SavedJob[]
  alerts          JobAlert[]

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([category, jobType])
}

/// What this student wants the aggregator to look for.
model JobPreference {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords           String[]  @default([])   // free-text search terms, e.g. "software intern"
  skills             String[]  @default([])   // "React", "Python", "Figma"
  preferredLocations String[]  @default([])   // "Dhaka", "Remote"
  jobTypes           String[]  @default(["INTERNSHIP"])
  minMatchScore      Int       @default(50)   // alerts only fire above this
  alertsEnabled      Boolean   @default(true)
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// A job the student bookmarked, plus their application pipeline status.
model SavedJob {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String     @default("SAVED") // SAVED | APPLIED | INTERVIEW | OFFER | REJECTED
  notes     String?
  appliedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
}

/// A generated notification: "this new listing matched your profile at 82%".
model JobAlert {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String
  job        JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchScore Int
  reason     String
  isRead     Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@unique([userId, jobId])
  @@index([userId, isRead])
}
