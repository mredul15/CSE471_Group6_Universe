generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Module 1: Feature 1 - Routine & Attendance
model Course {
  id               String         @id @default(cuid())
  code             String         
  name             String         
  routines         ClassRoutine[]
  attendances      Attendance[]
}

model ClassRoutine {
  id        String @id @default(cuid())
  courseId  String
  day       String 
  startTime String 
  endTime   String 
  course    Course @relation(fields: [courseId], references: [id])
}

model Attendance {
  id        String   @id @default(cuid())
  courseId  String
  date      DateTime @default(now())
  status    String   
  course    Course   @relation(fields: [courseId], references: [id])
}

// Module 1: Feature 3 - CGPA Forecast
model AcademicGoal {
  id               String   @id @default(cuid())
  studentId        String   @default("student-current") 
  semesterNumber   Int      @default(1)
  currentCgpa      Float
  completedCredits Int
  targetCgpa       Float
  upcomingCredits  Int
  requiredGpa      Float
  isPossible       Boolean
  createdAt        DateTime @default(now())
  
  // This links the specific courses to this exact goal
  simulatedCourses SimulatedCourse[] 
}

// NEW: Model to save the actual courses added by the user
model SimulatedCourse {
  id             String       @id @default(cuid())
  academicGoalId String
  name           String
  credits        Float
  targetGrade    String
  
  // If the goal is deleted, delete these courses too
  academicGoal   AcademicGoal @relation(fields: [academicGoalId], references: [id], onDelete: Cascade)
}
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  department     String
  semester       Int
  currentCgpa    Float
  createdAt      DateTime @default(now())
}